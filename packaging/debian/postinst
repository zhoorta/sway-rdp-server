#!/bin/sh
set -e
if [ "$1" = configure ]; then
    getent passwd waydesk >/dev/null || adduser --system --group --no-create-home --home /nonexistent --shell /usr/sbin/nologin --gecos "waydesk daemon" waydesk
    # The group whose members may log in over RDP. On a first install the account that ran the installation joins it, or nobody could.
    getent group waydesk-users >/dev/null || addgroup --system waydesk-users >/dev/null
    if [ -z "$2" ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
        adduser "$SUDO_USER" waydesk-users >/dev/null 2>&1 || true
    fi
    mkdir -p /etc/waydesk
    if [ ! -f /etc/waydesk/key.pem ]; then
        openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$(hostname)" \
            -keyout /etc/waydesk/key.pem -out /etc/waydesk/cert.pem >/dev/null 2>&1
        echo "waydesk: made a self-signed certificate. Check this fingerprint in your RDP client on first connect:"
        openssl x509 -in /etc/waydesk/cert.pem -noout -fingerprint -sha256 | sed 's/^/    /'
    fi
    chown root:waydesk /etc/waydesk
    chmod 750 /etc/waydesk
    chown waydesk:waydesk /etc/waydesk/key.pem /etc/waydesk/cert.pem
    chmod 600 /etc/waydesk/key.pem
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Compressed swap in RAM (systemd-zram-generator, a dependency: a minimal image skips Recommends) and its kernel settings, without a reboot.
    /usr/lib/systemd/systemd-sysctl /usr/lib/sysctl.d/50-waydesk.conf >/dev/null 2>&1 || true
    if [ -x /usr/lib/systemd/system-generators/zram-generator ] && ! grep -q zram /proc/swaps 2>/dev/null; then
        systemctl start systemd-zram-setup@zram0.service >/dev/null 2>&1 || true
    fi
    systemctl enable waydesk-helper.service waydesk.service >/dev/null 2>&1 || true
    systemctl restart waydesk-helper.service waydesk.service >/dev/null 2>&1 || true
    # On a first install nobody may log in over RDP until an account is in waydesk-users (the account that ran the installation was added
    # above). When there is none, say how to make the first administrator.
    if [ -z "$2" ] && [ -z "$(getent group waydesk-users | cut -d: -f4)" ]; then
        echo "waydesk: nobody can log in over RDP yet. Make the first administrator:  sudo waydesk-setup-admin"
    fi
fi
exit 0
