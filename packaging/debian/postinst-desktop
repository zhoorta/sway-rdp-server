#!/bin/sh
set -e
# The black and white icon theme of earlier versions is not used any more.
if [ "$1" = configure ]; then
    rm -rf /usr/share/icons/SwayRdp-Mono
fi
# DMS only watches app folders that exist when it starts; Flatpak makes this one on the first install, so the first
# Flatpak app would not show up in the launcher until DMS restarts.
if [ "$1" = configure ]; then
    mkdir -p /var/lib/flatpak/exports/share/applications
fi
# The group whose members install Flatpaks system-wide without a password (see the polkit rule); empty until an administrator adds
# somebody: adduser ACCOUNT waydesk-admins
if [ "$1" = configure ]; then
    getent group waydesk-admins >/dev/null || addgroup --system waydesk-admins >/dev/null
fi
# Flatpak apps are sandboxed: let them read the GTK settings of the account (the shell's colours), or they look like stock GNOME.
if [ "$1" = configure ] && command -v flatpak >/dev/null 2>&1; then
    flatpak override --system --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro || true
fi
exit 0
