#!/bin/sh
set -e
# The black and white icon theme of earlier versions is not used any more.
if [ "$1" = configure ]; then
    rm -rf /usr/share/icons/SwayRdp-Mono
fi
# DMS only watches app folders that exist when it starts; Flatpak makes this one on the first install, so the first
# Flatpak app would not show up in the launcher until DMS restarts.
if [ "$1" = configure ]; then
    mkdir -p /var/lib/flatpak/exports/share/applications
fi
# The group whose members install Flatpaks system-wide without a password (see the polkit rule); empty until an administrator adds
# somebody: adduser ACCOUNT waydesk-admins
if [ "$1" = configure ]; then
    getent group waydesk-admins >/dev/null || addgroup --system waydesk-admins >/dev/null
fi
# Flatpak apps are sandboxed: let them read the GTK settings of the account (the shell's colours), or they look like stock GNOME.
if [ "$1" = configure ] && command -v flatpak >/dev/null 2>&1; then
    flatpak override --system --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro || true
fi
# Flathub, so that the Software app has apps to show and Flatpak apps install as the site says ("Flathub works as it is"). Without a remote the
# Explore page of Software is empty. Needs the network: when there is none, say how to do it later and carry on (the install must not fail).
if [ "$1" = configure ] && command -v flatpak >/dev/null 2>&1 && ! flatpak remotes --system 2>/dev/null | grep -q '^flathub'; then
    if timeout 60 flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >/dev/null 2>&1; then
        timeout 120 flatpak update --appstream --system >/dev/null 2>&1 || true
    else
        echo "waydesk-desktop: could not add Flathub (no network?). Later: sudo flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo" >&2
    fi
fi
# A browser by default. Debian has a Chromium package (a recommend of this one); Ubuntu has only a stub that installs the snap, which the versioned
# recommend does not accept. Where the archive has no Chromium, the one from Flathub is installed here (about 190 MB to download): it is the one the shell
# pins in the dock and seeds for each account. Needs the network; without it the install goes on and says how to do it later.
if [ "$1" = configure ] && command -v flatpak >/dev/null 2>&1 && flatpak remotes --system 2>/dev/null | grep -q '^flathub' \
    && ! dpkg-query -W -f='${Status}' chromium 2>/dev/null | grep -q 'ok installed' \
    && [ -z "$(apt-cache policy chromium 2>/dev/null | awk '/Candidate:/ && $2 != "(none)"')" ] \
    && ! flatpak info --system org.chromium.Chromium >/dev/null 2>&1; then
    echo "waydesk-desktop: installing Chromium from Flathub (about 190 MB) ..." >&2
    timeout 900 flatpak install --system -y --noninteractive flathub org.chromium.Chromium >/dev/null 2>&1 \
        || echo "waydesk-desktop: could not install Chromium (no network?). Later: sudo flatpak install --system flathub org.chromium.Chromium" >&2
fi
exit 0
