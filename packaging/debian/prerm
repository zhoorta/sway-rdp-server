#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = deconfigure ]; then
    systemctl stop sway-rdp.service sway-rdp-helper.service "sway-rdp-session@*.service" >/dev/null 2>&1 || true
    systemctl disable sway-rdp.service sway-rdp-helper.service >/dev/null 2>&1 || true
fi
exit 0
