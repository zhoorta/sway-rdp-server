#!/usr/bin/env python3
"""Prints the process id of the window that has the focus in sway (0 when there is none).

The shell's focused-window menu shows this id and offers "Kill Process", but DMS only knows where to find it on niri, Hyprland
and Mango: on sway the Wayland toplevel has no pid, so the menu says "Unavailable" and its button does nothing.
"""
import json
import subprocess


def focused(node):
    if node.get("focused"):
        return node.get("pid") or 0
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused(child)
        if found:
            return found
    return 0


try:
    print(focused(json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree"]))))
except Exception:
    print(0)
