#!/bin/sh
# Chooses and installs desktop shell, developer, creative and AI apps (whiptail wizard). Run it as an ordinary account
# that may use sudo; --list shows what can be installed.
case "${1:-}" in
    --list) exec /usr/share/sway-rdp/setup/install.sh --list ;;
    --check) exec /usr/share/sway-rdp/setup/install.sh --check ;;
    "") exec /usr/share/sway-rdp/setup/wizard.sh ;;
    *) echo "usage: sway-rdp-setup [--list|--check]" >&2; exit 1 ;;
esac
