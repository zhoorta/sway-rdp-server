#!/usr/bin/env python3
"""Folders and places in the accent colour of the shell: waydesk-mkicons --user

The icons of the desktop are Papirus-Dark, apps in their own colours. Its folders are blue, though, which clashes with any
accent: this makes a small overlay of that theme for the account, only the folders and places, in the hue of the primary colour of
its DankMaterialShell theme (the default lavender while DMS has not made its palette yet). The overlay lives in
~/.local/share/icons/Papirus-Dark; Qt and GTK merge themes of one name, so everything else comes from the system theme.
"""
import colorsys
import json
import os
import re
import shutil
import sys

THEME = "Papirus-Dark"
PARENT = "Papirus"  # where most of the icons of Papirus-Dark really are (its size folders are links into it)
SIZES = ("16x16", "22x22", "24x24", "32x32", "48x48", "64x64")
DEFAULT_ACCENT = "d0bcff"  # the default primary of DankMaterialShell
VERSION = "1"  # changes with the way the overlay is made, so that an older one is made again

# Colours in fill, stroke, stop-color ... (attributes and style properties), not element ids such as url(#abc).
COLOR = re.compile(r'((?:fill|stroke|stop-color|flood-color|lighting-color|color)(?:=["\']|:\s*))#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![0-9a-zA-Z_-])')

# The folder icons a file manager asks for; the rest of folder-* (two thousand colour and brand variants) stays with the system theme.
USER_FOLDERS = {"documents", "download", "downloads", "music", "pictures", "videos", "templates", "publicshare", "desktop", "remote", "network",
                "home", "recent", "saved-search", "drag-accept", "visiting", "new", "favorites", "important", "development", "games", "code",
                "activities", "backup", "books", "cloud", "projects", "public", "script", "steam"}


def accent_hue():
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    primary = DEFAULT_ACCENT
    # DMS 2.0 keeps its palette in ~/.cache/dms; before that it was ~/.cache/DankMaterialShell.
    colors = next((p for p in (os.path.join(cache, d, "dms-colors.json") for d in ("dms", "DankMaterialShell")) if os.path.exists(p)), "")
    try:
        with open(colors) as f:
            data = json.load(f)
        mode = data.get("mode") if data.get("mode") in data.get("colors", {}) else "dark"
        primary = data["colors"][mode]["primary"].lstrip("#")
    except (OSError, ValueError, KeyError):
        pass
    return colorsys.rgb_to_hls(*(int(primary[i:i + 2], 16) / 255 for i in (0, 2, 4)))[0]


def main():
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    target = os.path.join(data_home, "icons", THEME)
    system = f"/usr/share/icons/{THEME}"
    if not os.path.isfile(os.path.join(system, "index.theme")):
        shutil.rmtree(target, ignore_errors=True)  # no such theme here: nothing to lay over
        return
    hue = accent_hue()
    stamp = os.path.join(target, ".hue")
    wanted = f"{VERSION}:{hue:.4f}"
    if os.path.exists(stamp) and open(stamp).read() == wanted:
        return

    def tint(m):
        h = m.group(2)
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
        _, light, sat = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        if sat < 0.12:  # greys, white and black stay as they are
            return m.group(0)
        r, g, b = (round(c * 255) for c in colorsys.hls_to_rgb(hue, min(0.78, light + 0.12), min(sat, 0.6)))
        return f"{m.group(1)}#{r:02x}{g:02x}{b:02x}"

    tmp = target + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    shutil.copy2(os.path.join(system, "index.theme"), os.path.join(tmp, "index.theme"))
    for size in SIZES:
        # The folders of this size, in the order of the theme's own lookup: Papirus-Dark first, then Papirus (the links of
        # Papirus-Dark lead there).
        sources = []
        for theme in (THEME, PARENT):
            path = os.path.realpath(f"/usr/share/icons/{theme}/{size}/places")
            if os.path.isdir(path) and path not in sources:
                sources.append(path)
        if not sources:
            continue

        def find(name):
            return next((os.path.join(d, name) for d in sources if os.path.lexists(os.path.join(d, name))), None)

        names = {n for d in sources for n in os.listdir(d)}
        keep, todo = set(), [n for n in names if not (n.startswith("folder-") and n[7:].rsplit(".", 1)[0].removesuffix("-open") not in USER_FOLDERS)]
        while todo:  # what is asked for, and what its links point to (folder.svg is a link to folder-blue.svg)
            name = todo.pop()
            if name in keep:
                continue
            keep.add(name)
            path = find(name)
            if path and os.path.islink(path) and "/" not in os.readlink(path):
                todo.append(os.readlink(path))
        out = os.path.join(tmp, size, "places")
        os.makedirs(out)
        for name in keep:
            path = find(name)
            if path is None:
                continue
            if os.path.islink(path):
                if "/" not in os.readlink(path):  # a link inside the folder stays one, its target is copied too
                    os.symlink(os.readlink(path), os.path.join(out, name))
            elif name.endswith(".svg"):
                with open(path, encoding="utf-8", errors="surrogateescape") as fh:
                    text = fh.read()
                with open(os.path.join(out, name), "w", encoding="utf-8", errors="surrogateescape") as fh:
                    fh.write(COLOR.sub(tint, text))
    with open(os.path.join(tmp, ".hue"), "w") as fh:
        fh.write(wanted)
    shutil.rmtree(target, ignore_errors=True)
    os.rename(tmp, target)


if "--user" not in sys.argv:
    sys.exit(__doc__)
main()
