#!/usr/bin/env python3
"""QTerminal in the colours of the shell: waydesk-terminal [qterminal options]

DankMaterialShell keeps ~/.config/foot/dank-colors.ini in step with its theme. This turns those colours into a colour scheme
for QTerminal each time it starts, and gives a new account a quiet setup (no accent border around the terminal, the terminal font; the window keeps its title bar). Settings the account changed afterwards stay as they are.
"""
import configparser
import os

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
SCHEME = "DMS"


def rgb(h):
    h = h.strip().lstrip("#")
    return ",".join(str(int(h[i:i + 2], 16)) for i in (0, 2, 4))


def scheme():
    ini = configparser.ConfigParser(interpolation=None)
    ini.optionxform = str
    if not ini.read(os.path.join(CONFIG, "foot/dank-colors.ini")) or "colors-dark" not in ini:
        return
    c = ini["colors-dark"]
    out = ["[General]", f"Description={SCHEME}", "Opacity=1", ""]

    def put(name, value):
        out.extend([f"[{name}]", "Bold=false", f"Color={rgb(value)}", ""])

    put("Background", c["background"])
    put("BackgroundIntense", c["background"])
    put("Foreground", c["foreground"])
    put("ForegroundIntense", c["foreground"])
    for i in range(8):
        put(f"Color{i}", c[f"regular{i}"])
        put(f"Color{i}Intense", c[f"bright{i}"])
    path = os.path.join(CONFIG, "qterminal.org/color-schemes")
    os.makedirs(path, exist_ok=True)
    with open(os.path.join(path, f"{SCHEME}.colorscheme"), "w") as f:
        f.write("\n".join(out))


def settings():
    path = os.path.join(CONFIG, "qterminal.org/qterminal.ini")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    ini = configparser.RawConfigParser()
    ini.optionxform = str
    ini.read(path)
    if "General" not in ini:
        ini["General"] = {}
    g = ini["General"]
    if "colorScheme" in g:  # set up before: the account owns the file now
        # Except for one thing we got wrong: "Borderless" asks for a window without a frame, so sway draws no title bar (and the
        # window buttons) and the terminal cannot be moved or closed. Once, an account that still has our value gets the frame.
        marker = os.path.join(CONFIG, "waydesk/.terminal-frame")
        if not os.path.exists(marker):
            os.makedirs(os.path.dirname(marker), exist_ok=True)
            open(marker, "w").close()
            if g.get("Borderless") == "true":
                g["Borderless"] = "false"
                with open(path, "w") as f:
                    ini.write(f, space_around_delimiters=False)
        return
    g.update({
        "colorScheme": SCHEME,
        "fontFamily": "JetBrains Mono",
        "fontSize": "10",
        "MenuVisible": "true",
        "Borderless": "false",
        "HideTabBarWithOneTab": "false",
        "highlightCurrentTerminal": "false",
        "TerminalMargin": "8",
        "ScrollbarPosition": "2",
        "AskOnExit": "false",
    })
    with open(path, "w") as f:
        ini.write(f, space_around_delimiters=False)


scheme()
settings()
os.environ.setdefault("QT_QPA_PLATFORM", "wayland")
os.environ.setdefault("QT_QPA_PLATFORMTHEME", "qt6ct")
os.execvp("qterminal", ["qterminal"] + os.sys.argv[1:])
