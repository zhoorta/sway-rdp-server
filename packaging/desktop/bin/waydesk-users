#!/bin/sh
# Users & Access: the panel for the accounts and sessions of the remote desktop (a small Quickshell window of its own, next to the
# shell; it asks for an administrator's password through polkit when something is changed).
# Only administrators (the group sudo, who polkit asks for a password) manage accounts.
if ! id -nG "$(id -un)" | tr ' ' '\n' | grep -qx sudo; then
    echo "Users & Access is for administrators." >&2
    notify-send "Users & Access" "Only administrators can manage the accounts of this desktop." 2>/dev/null
    exit 1
fi
# The window's app id is the name of the launcher entry (waydesk-users.desktop), so the dock shows its own icon and name instead of Quickshell's.
export QS_APP_ID=waydesk-users
export QT_QPA_PLATFORMTHEME=qt6ct QT_QUICK_CONTROLS_STYLE=Fusion
exec quickshell -p /usr/share/waydesk/users-panel
