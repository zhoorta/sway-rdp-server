#!/usr/bin/env python3
"""A desktop background and folder icons in the accent colours of the shell: waydesk-wallpaper [--once]

The folders and places follow the accent too: waydesk-mkicons --user makes this account's overlay of the icon theme, and the
desktop (pcmanfm-qt) is started again to show it, once no file manager window is open (they would close with it).

Soft glows of the DankMaterialShell palette (the accent and its companions) on the surface colour, made as a PNG with no
image library and handed to pcmanfm-qt, which draws the desktop. It is made again when the account changes the theme
colour (DMS rewrites ~/.cache/dms/dms-colors.json). An account that picked a wallpaper of its own in the
desktop settings keeps it: this only replaces what it made itself.

A wallpaper picked in the shell's settings (DMS keeps it in ~/.local/state/dms/session.json) is handed to pcmanfm-qt too, with
its fill mode, because pcmanfm-qt draws the desktop and the shell's own wallpaper layer is off; cleared again, the generated
background comes back. A solid colour becomes a one colour image. A wallpaper per monitor and a light and a dark one are not followed (the shared path is).
"""
import colorsys
import hashlib
import json
import math
import os
import random
import struct
import subprocess
import sys
import time
import zlib

HOME = os.path.expanduser("~")
CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")


def colors_path():
    """DMS 2.0 keeps its palette in ~/.cache/dms; before that it was ~/.cache/DankMaterialShell."""
    for folder in ("dms", "DankMaterialShell"):
        path = os.path.join(CACHE, folder, "dms-colors.json")
        if os.path.exists(path):
            return path
    return os.path.join(CACHE, "dms/dms-colors.json")


OUT_DIR = os.path.join(CACHE, "waydesk")
MIRRORED = os.path.join(OUT_DIR, ".mirrored")  # the image of the shell's settings that pcmanfm-qt was given
STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
# DMS fill modes as pcmanfm-qt calls them (anything else: fill)
FILL_MODES = {"Stretch": "stretch", "Fit": "fit", "Fill": "zoom", "Scrolling": "zoom", "Tile": "tile", "TileVertically": "tile", "TileHorizontally": "tile", "Pad": "center"}
FM_SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "pcmanfm-qt/default/settings.conf")
W, H = 960, 540  # smooth gradients: pcmanfm-qt scales it to the screen


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def palette():
    with open(colors_path()) as f:
        data = json.load(f)
    mode = data.get("mode") if data.get("mode") in data.get("colors", {}) else "dark"
    c = data["colors"][mode]
    primary = rgb(c["primary"])
    glow = rgb(c.get("primary_container", c["primary"]))

    def turned(colour, hue, light=None, sat=None):
        """The colour with its hue turned, so a second and third glow go with the accent whatever the user picked."""
        h, l, s = colorsys.rgb_to_hls(*(v / 255 for v in colour))
        return tuple(round(v * 255) for v in colorsys.hls_to_rgb((h + hue) % 1, l if light is None else light, s if sat is None else sat))

    return {
        "mode": mode,
        "base": rgb(c.get("surface_container_lowest") if mode == "dark" else c.get("surface", c["background"])),
        "glow": glow,
        "primary": primary,
        "deep": turned(glow, -0.09),  # towards blue
        "tertiary": turned(primary, 0.09),  # towards pink
    }


def render(p):
    dark = p["mode"] == "dark"
    # (centre x, centre y, radius, colour, strength): the blobs overlap, strongest first.
    blobs = [
        (0.14, 0.10, 0.85, p["glow"], 0.95 if dark else 0.60),
        (0.92, 0.92, 0.75, p["deep"], 0.85 if dark else 0.55),
        (0.52, 0.38, 0.30, p["primary"], 0.16 if dark else 0.25),
        (0.88, 0.28, 0.22, p["tertiary"], 0.10 if dark else 0.18),
    ]
    k = 2.2  # how fast a blob fades out
    cols = []
    for cx, cy, r, colour, strength in blobs:
        # Distances in units of the screen width, so a blob is round; exp(-a-b) = exp(-a) * exp(-b) keeps it cheap.
        ex = [math.exp(-k * ((x / W - cx) ** 2) / (r * r)) for x in range(W)]
        ey = [math.exp(-k * (((y / H - cy) * H / W) ** 2) / (r * r)) for y in range(H)]
        cols.append((ex, ey, colour, strength))
    ux = [(x / W - 0.5) ** 2 for x in range(W)]
    uy = [(y / H - 0.5) ** 2 for y in range(H)]
    vignette = 0.45 if dark else 0.10
    base = p["base"]
    rnd = random.Random(7)
    noise = [rnd.random() - 0.5 for _ in range(4096)]
    raw = bytearray()
    i = 0
    for y in range(H):
        raw.append(0)  # PNG filter: none
        row_weights = [(ey[y], colour, strength) for ex, ey, colour, strength in cols]
        v_row = uy[y]
        for x in range(W):
            r, g, b = base
            for n, (ey_y, colour, strength) in enumerate(row_weights):
                w = strength * cols[n][0][x] * ey_y
                r += (colour[0] - r) * w
                g += (colour[1] - g) * w
                b += (colour[2] - b) * w
            v = 1 - vignette * (ux[x] + v_row)
            d = noise[i & 4095]  # a little noise: smooth dark gradients show bands without it
            i += 1
            raw += bytes((max(0, min(255, int(r * v + d + 0.5))), max(0, min(255, int(g * v + d + 0.5))), max(0, min(255, int(b * v + d + 0.5)))))

    def chunk(tag, data):
        body = tag + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b"")


def read_json(*paths):
    for path in paths:
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            continue
    return {}


def solid_image(colour):
    """A small PNG of one colour (stretched over the screen) for a colour picked in the shell's settings."""
    try:
        r, g, b = rgb(colour)
    except ValueError:
        return None
    path = os.path.join(OUT_DIR, f"color-{r:02x}{g:02x}{b:02x}.png")
    if not os.path.exists(path):
        os.makedirs(OUT_DIR, exist_ok=True)
        body = zlib.compress((b"\x00" + bytes((r, g, b)) * 8) * 8)

        def chunk(tag, data):
            return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

        png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 8, 8, 8, 2, 0, 0, 0)) + chunk(b"IDAT", body) + chunk(b"IEND", b"")
        with open(path + ".new", "wb") as f:
            f.write(png)
        os.replace(path + ".new", path)
    return path


def dms_wallpaper():
    """(image path, pcmanfm-qt fill mode) of the wallpaper picked in the shell's settings, or None (not set, or a colour)."""
    session = read_json(*(os.path.join(STATE, d, "session.json") for d in ("dms", "DankMaterialShell")))
    path = session.get("wallpaperPath")
    if not isinstance(path, str):
        return None
    path = path[len("file://"):] if path.startswith("file://") else path
    if path.startswith("#"):
        solid = solid_image(path)
        return (solid, "stretch") if solid else None
    if not path.startswith("/") or not os.path.isfile(path):
        return None
    settings = read_json(*(os.path.join(CONFIG, d, "settings.json") for d in ("dms", "DankMaterialShell")))
    return path, FILL_MODES.get(settings.get("wallpaperFillMode"), "zoom")


def mirrored():
    try:
        with open(MIRRORED) as f:
            return f.read().strip()
    except OSError:
        return ""


def account_has_its_own():
    """True when the desktop settings name a wallpaper that neither this script made nor it took from the shell's settings."""
    try:
        with open(FM_SETTINGS) as f:
            for line in f:
                if line.startswith("Wallpaper="):
                    path = line.split("=", 1)[1].strip()
                    return bool(path) and not path.startswith(OUT_DIR + os.sep) and path != mirrored()
    except OSError:
        pass
    return False


def theme_mode():
    try:
        with open(colors_path()) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return "dark"
    return "light" if data.get("mode") == "light" else "dark"


def label_colors(mode):
    """The colour of the desktop item names follows the theme: pcmanfm-qt's white with a dark shadow is lost on a light background.
    True when the settings file changed (the desktop has to start again to show it)."""
    want = {"FgColor": "#1b1b1f", "ShadowColor": "#ffffff"} if mode == "light" else {"FgColor": "#ffffff", "ShadowColor": "#000000"}
    try:
        with open(FM_SETTINGS) as f:
            lines = f.read().split("\n")
    except OSError:
        return False
    start = next((i for i, l in enumerate(lines) if l.strip() == "[Desktop]"), None)
    if start is None:
        return False
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    changed = False
    for key, value in want.items():
        line = f"{key}={value}"
        at = next((i for i in range(start + 1, end) if lines[i].startswith(key + "=")), None)
        if at is None:
            lines.insert(start + 1, line)
            end += 1
            changed = True
        elif lines[at] != line:
            lines[at] = line
            changed = True
    if changed:
        with open(FM_SETTINGS + ".new", "w") as f:
            f.write("\n".join(lines))
        os.replace(FM_SETTINGS + ".new", FM_SETTINGS)
    return changed


def set_wallpaper(path, mode):
    env = dict(os.environ, QT_QPA_PLATFORM="wayland", QT_QPA_PLATFORMTHEME="qt6ct")
    subprocess.run(["pcmanfm-qt", f"--set-wallpaper={path}", f"--wallpaper-mode={mode}"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def mirror(image):
    path, mode = image
    os.makedirs(OUT_DIR, exist_ok=True)
    with open(MIRRORED, "w") as f:
        f.write(path + "\n")
    set_wallpaper(path, mode)


def apply(p):
    tag = hashlib.sha1(json.dumps(p, sort_keys=True).encode()).hexdigest()[:10]
    path = os.path.join(OUT_DIR, f"wallpaper-{tag}.png")
    if not os.path.exists(path):
        os.makedirs(OUT_DIR, exist_ok=True)
        data = render(p)
        with open(path + ".new", "wb") as f:
            f.write(data)
        os.replace(path + ".new", path)
    set_wallpaper(path, "zoom")
    try:
        os.remove(MIRRORED)
    except OSError:
        pass
    for name in os.listdir(OUT_DIR):  # earlier ones of this script
        if name.startswith("wallpaper-") and name.endswith(".png") and os.path.join(OUT_DIR, name) != path:
            os.remove(os.path.join(OUT_DIR, name))


ICON_STAMP = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "icons/Papirus-Dark/.hue")


def icon_hue():
    try:
        with open(ICON_STAMP) as f:
            return f.read()
    except OSError:
        return None


def file_manager_windows():
    """How many pcmanfm-qt windows are open (the desktop itself is not a window of sway)."""
    try:
        tree = json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree"]))
    except Exception:
        return 0

    def count(node):
        return (node.get("app_id") == "pcmanfm-qt") + sum(count(c) for c in node.get("nodes", []) + node.get("floating_nodes", []))

    return count(tree)


def main():
    once = "--once" in sys.argv
    unset = object()
    last_image, last_colors = unset, None
    restart_desktop = False
    while True:
        try:
            stamp = os.path.getmtime(colors_path())
        except OSError:
            stamp = None
        image = dms_wallpaper()
        image_changed, colors_changed = image != last_image, stamp is not None and stamp != last_colors
        if image_changed or colors_changed:
            # pcmanfm-qt may not be there yet (the desktop waits for the screen): --set-wallpaper then starts nothing useful
            if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "pcmanfm-qt"], stdout=subprocess.DEVNULL).returncode == 0:
                own = account_has_its_own()
                if image is not None:
                    # A wallpaper picked in the shell's settings wins, except that one the account's own choice in the file
                    # manager is not replaced by an old setting of the shell at the start of the session.
                    if image_changed and not (last_image is unset and own):
                        mirror(image)
                elif own:
                    return
                elif stamp is not None:
                    apply(palette())
                if colors_changed or last_colors is None:
                    restart_desktop = label_colors(theme_mode()) or restart_desktop
                if colors_changed:
                    before = icon_hue()
                    subprocess.run(["waydesk-mkicons", "--user"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    restart_desktop = restart_desktop or icon_hue() != before
                last_image = image
                if stamp is not None:
                    last_colors = stamp
        # A running pcmanfm-qt keeps the icons it has: it has to start again to show the new ones. The desktop script
        # (waydesk-desktop) starts it again by itself. It is killed (not asked to end): ending it saves its own settings over
        # the label colours written above.
        if restart_desktop and not file_manager_windows():
            subprocess.run(["pkill", "-KILL", "-u", str(os.getuid()), "-x", "pcmanfm-qt"])
            restart_desktop = False
        if once:
            return
        time.sleep(1)


main()
