#!/usr/bin/env python3
"""Window helpers for waydesk sessions (floating windows): maximize, minimize, and keeping title bars reachable.

  waydesk-windows maximize [on|off]   toggle: fill the usable area (below the shell's bar), or go back to the old size (on / off: only to that state)
  waydesk-windows minimize   send the focused window to the scratchpad
  waydesk-windows restore [ID]  bring a minimized window back (the last one without an ID)
  waydesk-windows list       the minimized windows as JSON: [{"id", "title", "app"}]
  waydesk-windows fit        pull every window of this workspace back into the usable area
  waydesk-windows watch      run `fit` twice a second (started by the session's sway config)
  waydesk-windows workspaces            the workspaces and their windows (minimized ones too) as JSON (the bar's workspace button uses it)
  waydesk-windows workspace-new         a new workspace at the next free number, and go to it
  waydesk-windows workspace-go NAME     go to a workspace
  waydesk-windows focus ID              focus a window (and so go to its workspace)
  waydesk-windows move-to ID NAME|new   send a window to a workspace (a new one, which it also goes to)
"""
import json
import os
import socket
import struct
import subprocess
import time
import sys

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "waydesk-windows.json")
# Where each minimized window came from: {window id: workspace name} (the scratchpad does not say).
MINIMIZED_FROM = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "waydesk-minimized.json")


def minimized_from():
    try:
        with open(MINIMIZED_FROM) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_minimized_from(data):
    try:
        with open(MINIMIZED_FROM, "w") as f:
            json.dump(data, f)
    except OSError:
        pass


def minimize():
    """Send the focused window to the scratchpad and remember the workspace it left: the windows that are new in the scratchpad
    afterwards came from the workspace in view (looking at what appeared is more reliable than at the focus, which the bar can hold)."""
    before = {m["id"] for m in minimized()}
    here = next((w["name"] for w in workspaces() if w["focused"]), None)
    command("move scratchpad")
    if here is None:
        return
    data = minimized_from()
    for m in minimized():
        if m["id"] not in before:
            data[str(m["id"])] = here
    save_minimized_from(data)


def restore(window_id=None):
    """Bring a minimized window back to the workspace it was minimized from (the last one without an id)."""
    if window_id is None:
        command("scratchpad show")
        return
    data = minimized_from()
    name = data.pop(str(window_id), None)
    if name is not None:
        save_minimized_from(data)
        if name != next((w["name"] for w in workspaces() if w["focused"]), None) and valid_workspace(name):
            command(f'workspace "{name}"')
    command(f"[con_id={window_id}] scratchpad show")


def ipc(kind, payload=""):
    """One request on sway's IPC socket (0 = run command, 1 = get workspaces, 4 = get tree)."""
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(os.environ["SWAYSOCK"])
        data = payload.encode()
        s.sendall(b"i3-ipc" + struct.pack("=II", len(data), kind) + data)
        head = b""
        while len(head) < 14:
            head += s.recv(14 - len(head))
        size = struct.unpack("=I", head[6:10])[0]
        body = b""
        while len(body) < size:
            body += s.recv(size - len(body))
    return json.loads(body)


def command(text):
    ipc(0, text)


def tree():
    return ipc(4)


def workspaces():
    return ipc(1)


def walk(node, ws=None):
    """Yields (workspace node, node) for every node below `node`."""
    if node.get("type") == "workspace":
        ws = node
    yield ws, node
    for c in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from walk(c, ws)


def usable(ws_name):
    """Usable area of a workspace (sway leaves out what the shell's bar reserves)."""
    for w in workspaces():
        if w["name"] == ws_name:
            r = w["rect"]
            return r["x"], r["y"], r["width"], r["height"]
    return None


def geometry(n):
    """Container position and content size: sway places the container, the rect is the content inside it."""
    r, d = n["rect"], n.get("deco_rect", {}).get("height", 0)
    return r["x"], r["y"] - d, r["width"], r["height"], d


def place(con_id, x, y, w=None, h=None, deco=0):
    """Move a container to layout position x, y; w, h (content size) too when given."""
    cmd = f"[con_id={con_id}] "
    if w is not None:
        cmd += f"resize set width {w}px height {h + deco}px, "
    command(cmd + f"move absolute position {x} {y}")


def fit_node(ws, n):
    """Keep a floating window reachable: inside the usable area of its workspace, except that the bottom may go down behind the dock
    (the title bar stays above it, so the window can always be dragged back)."""
    area = usable(ws["name"])
    if not area or n.get("fullscreen_mode"):
        return
    ax, ay, aw, ah = area
    x, y, w, h, deco = geometry(n)
    nw, nh = min(w, aw), min(h, ah - deco)
    nx = min(max(x, ax), ax + aw - nw)
    ny = min(max(y, ay), ay + ah - deco)
    if (nx, ny, nw, nh) != (x, y, w, h):
        place(n["id"], nx, ny, nw, nh, deco)


def floating_windows():
    for ws, n in walk(tree()):
        if ws is not None and any(f["id"] == n["id"] for f in ws.get("floating_nodes", [])):
            yield ws, n


def focused():
    for ws, n in walk(tree()):
        if n.get("focused") and ws is not None:
            return ws, n
    return None, None


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def maximize(want=None):
    """Toggle; with want "on" or "off" only go to that state (an application asking for it twice does not undo itself)."""
    ws, n = focused()
    if n is None:
        return
    saved = load()
    key = str(n["id"])
    if (want == "on" and key in saved) or (want == "off" and key not in saved):
        return
    x, y, w, h, deco = geometry(n)
    if key in saved:
        x, y, w, h = saved.pop(key)
        place(n["id"], x, y, w, h, deco)
    else:
        area = usable(ws["name"])
        if not area:
            return
        saved[key] = [x, y, w, h]
        ax, ay, aw, ah = area
        place(n["id"], ax, ay, aw, ah - deco, deco)
    try:
        with open(STATE, "w") as f:
            json.dump(saved, f)
    except OSError:
        pass


def minimized():
    """Windows sent to the scratchpad by `minimize`."""
    out = []
    for ws, n in walk(tree()):
        if ws is not None and ws.get("name") == "__i3_scratch" and n["id"] in [f["id"] for f in ws.get("floating_nodes", [])]:
            out.append({"id": n["id"], "title": n.get("name") or "", "app": n.get("app_id") or (n.get("window_properties") or {}).get("class") or ""})
    return out


def fit_all():
    focused_ws = next((w["name"] for w in workspaces() if w["focused"]), None)
    for ws, n in floating_windows():
        if ws["name"] == focused_ws:
            fit_node(ws, n)


FIRST_WORKSPACE = "Remote"
MAX_WORKSPACES = 4


def valid_workspace(name):
    """A name that is safe to put in a sway command: letters, digits, space, _ and -, at most 32 characters."""
    return 0 < len(name) <= 32 and all(c.isalnum() or c in " _-" for c in name)


def workspace_list():
    """[{name, focused, visible, windows: [{id, title, app, focused}]}], the first workspace first, then by number."""
    out = {}
    for w in workspaces():
        if w["name"] != "__i3_scratch":
            out[w["name"]] = {"name": w["name"], "focused": bool(w.get("focused")), "visible": bool(w.get("visible")), "windows": []}
    for ws, n in walk(tree()):
        if ws is None or ws["name"] not in out or n.get("nodes") or n.get("floating_nodes"):
            continue
        app = n.get("app_id") or (n.get("window_properties") or {}).get("class")
        if app is not None or n.get("window") is not None:
            out[ws["name"]]["windows"].append({"id": n["id"], "title": n.get("name") or "", "app": app or "", "focused": bool(n.get("focused"))})

    # Minimized windows are in the scratchpad: list them under the workspace they came from (that one may be gone, it
    # is shown anyway), dimmed by the bar.
    came_from = minimized_from()
    here = next((w["name"] for w in workspaces() if w["focused"]), FIRST_WORKSPACE)
    for m in minimized():
        name = came_from.get(str(m["id"]), here)
        if name not in out:
            if not valid_workspace(name):
                name = here
            out.setdefault(name, {"name": name, "focused": False, "visible": False, "windows": []})
        out[name]["windows"].append({"id": m["id"], "title": m["title"], "app": m["app"], "focused": False, "minimized": True})

    def order(w):
        return (w["name"] != FIRST_WORKSPACE, not w["name"].isdigit(), int(w["name"]) if w["name"].isdigit() else 0, w["name"])

    return sorted(out.values(), key=order)


def next_workspace_name(names):
    """The first of Remote, 2, 3 and 4 that no workspace has (the keys reach those four), or None when there are four already."""
    if len(names) >= MAX_WORKSPACES:
        return None
    return next((n for n in [FIRST_WORKSPACE] + [str(i) for i in range(2, MAX_WORKSPACES + 1)] if n not in names), None)


def new_workspace():
    name = next_workspace_name({w["name"] for w in workspace_list()})
    if name is None:
        sys.exit(f"{MAX_WORKSPACES} workspaces is the most")
    command(f'workspace "{name}"')
    return name


def new_workspace_name():
    name = next_workspace_name({w["name"] for w in workspace_list()})
    if name is None:
        sys.exit(f"{MAX_WORKSPACES} workspaces is the most")
    return name


THEME = os.path.expanduser("~/.config/gtk-3.0/dank-colors.css")


def theme_stamp():
    try:
        return os.stat(THEME).st_mtime
    except OSError:
        return None


def watch():
    """Dragging a window sends sway no event, so look twice a second (and at the shell's theme file: the title bar buttons follow it)."""
    stamp = theme_stamp()
    while True:
        try:
            fit_all()
        except (OSError, ValueError, KeyError):
            return  # sway is gone
        now = theme_stamp()
        if now != stamp:
            stamp = now
            subprocess.run(["waydesk-titlebar-buttons", "colors"], check=False)
        time.sleep(0.5)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "maximize":
        maximize(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd == "minimize":
        minimize()
    elif cmd == "restore":
        restore(int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else None)
    elif cmd == "list":
        print(json.dumps(minimized()))
    elif cmd == "fit":
        fit_all()
    elif cmd == "watch":
        watch()
    elif cmd == "workspaces":
        print(json.dumps(workspace_list()))
    elif cmd == "workspace-new":
        new_workspace()
    elif cmd == "workspace-go" and len(sys.argv) > 2 and valid_workspace(sys.argv[2]):
        command(f'workspace "{sys.argv[2]}"')
    elif cmd == "focus" and len(sys.argv) > 2 and sys.argv[2].isdigit():
        command(f"[con_id={sys.argv[2]}] focus")
    elif cmd == "move-to" and len(sys.argv) > 3 and sys.argv[2].isdigit() and (sys.argv[3] == "new" or valid_workspace(sys.argv[3])):
        target = new_workspace_name() if sys.argv[3] == "new" else sys.argv[3]
        command(f'[con_id={sys.argv[2]}] move container to workspace "{target}"')
        if sys.argv[3] == "new":
            command(f'workspace "{target}"')
    else:
        sys.exit(__doc__)


main()
