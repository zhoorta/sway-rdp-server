# waydesk: the default browser of the sessions is Chromium. An account's own ~/.config/mimeapps.list comes first.
[Default Applications]
text/html=chromium.desktop;org.chromium.Chromium.desktop
application/xhtml+xml=chromium.desktop;org.chromium.Chromium.desktop
x-scheme-handler/http=chromium.desktop;org.chromium.Chromium.desktop
x-scheme-handler/https=chromium.desktop;org.chromium.Chromium.desktop
