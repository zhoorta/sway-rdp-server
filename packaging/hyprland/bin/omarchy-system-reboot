#!/bin/sh
# Waydesk sessions: stand-in for Omarchy's reboot (found first on the session's PATH, see worker.rs prefer_private_bin).
#
# The server is shared: an ordinary account may not reboot it (packaging/polkit/50-waydesk-no-power.rules refuses it), and Omarchy's menu entry would
# announce "Reboot" and then fail two seconds later. This says so at once. An administrator (group wheel) gets Omarchy's own command.
if id -nG | tr ' ' '\n' | grep -qx wheel; then
    exec /usr/bin/omarchy-system-reboot "$@"
fi
command -v omarchy-osd >/dev/null 2>&1 && omarchy-osd -i reboot -m "Reboot is disabled on this server" -d 4000 >/dev/null 2>&1
exit 0
