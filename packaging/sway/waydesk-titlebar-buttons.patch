+static void publish_surface_cursor(struct sway_cursor *cursor) {
+	static char *last = NULL;
+	char *payload = cursor->image_surface ?
+		waydesk_cursor_payload(cursor->image_surface, cursor->hotspot_x, cursor->hotspot_y) : NULL;
+	if (!payload) {
+		// no image yet (the application has not committed one) or one that is too big: the arrow meanwhile
+		ipc_event_cursor(cursor->image_surface ? "default" : "none");
+		free(last);
