+struct cairo_buffer {
+	struct wlr_buffer base;
+	cairo_surface_t *surface;
+	cairo_t *cairo;
+};
+
+static void cairo_buffer_handle_destroy(struct wlr_buffer *wlr_buffer) {
+	struct cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	cairo_destroy(buffer->cairo);
+	cairo_surface_destroy(buffer->surface);
+	free(buffer);
+}
+
+static bool cairo_buffer_handle_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct cairo_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	cairo_surface_flush(buffer->surface);
+	*data = cairo_image_surface_get_data(buffer->surface);
+	*stride = cairo_image_surface_get_stride(buffer->surface);
+	*format = DRM_FORMAT_ARGB8888;
+	return true;
+}
+
+static void cairo_buffer_handle_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+}
+
+static const struct wlr_buffer_impl cairo_buffer_impl = {
+	.destroy = cairo_buffer_handle_destroy,
+	.begin_data_ptr_access = cairo_buffer_handle_begin_data_ptr_access,
+	.end_data_ptr_access = cairo_buffer_handle_end_data_ptr_access,
+};
+
+struct wlr_buffer *waydesk_cairo_buffer_create(int width, int height, cairo_t **cairo) {
+	struct cairo_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		return NULL;
+	}
+	buffer->surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width, height);
+	if (cairo_surface_status(buffer->surface) != CAIRO_STATUS_SUCCESS) {
+		cairo_surface_destroy(buffer->surface);
+		free(buffer);
+		return NULL;
+	}
+	buffer->cairo = cairo_create(buffer->surface);
+	wlr_buffer_init(&buffer->base, &cairo_buffer_impl, width, height);
+	*cairo = buffer->cairo;
+	return &buffer->base;
+}
+
+// ---- the shadow ----
+
+// The light comes from the top left: the shadow is the window's shape moved down and to the right, with rounded corners and a soft edge,
+// so that it shows on the right and the bottom, fading in below the top right corner and to the right of the bottom left one.
+#define SHADOW_BLUR 12 // half the width of the soft edge, in pixels
+#define SHADOW_RADIUS 14 // radius of the rounded corners of the shadow
+#define SHADOW_DX 8 // how far to the right of the window it sits
+#define SHADOW_DY 8 // how far lower
+#define SHADOW_PEAK 0.28f // opacity inside it
+#define SHADOW_INSIDE (SHADOW_BLUR + SHADOW_RADIUS) // how far inside the edge a corner piece reaches
+#define SHADOW_PART (SHADOW_BLUR + SHADOW_INSIDE) // size of a corner piece
+
+static float shadow_alpha(float distance) {
+	float t = (distance + SHADOW_BLUR) / (2.0f * SHADOW_BLUR);
+	t = t < 0 ? 0 : (t > 1 ? 1 : t);
+	return SHADOW_PEAK * (1.0f - t * t * (3.0f - 2.0f * t));
+}
+
+// Distance from the edge of the shadow's rounded rectangle (positive outside, negative inside) of a point of the piece at its top left
+// corner, measured from the piece's top left; the rectangle's corner is at (SHADOW_BLUR, SHADOW_BLUR).
+static float corner_distance(float x, float y) {
+	float cx = SHADOW_BLUR + SHADOW_RADIUS;
+	float qx = cx - x, qy = cx - y;
+	float ox = qx > 0 ? qx : 0, oy = qy > 0 ? qy : 0;
+	float inner = qx > qy ? qx : qy;
+	if (inner > 0) {
+		inner = 0;
+	}
+	return hypotf(ox, oy) + inner - SHADOW_RADIUS;
+}
+
+// Part numbers: 0 top left, 1 top, 2 top right, 3 left, 4 right, 5 bottom left, 6 bottom, 7 bottom right, 8 the inside.
+static struct wlr_buffer *shadow_textures[9];
+
+static struct wlr_buffer *make_shadow_texture(int part) {
+	bool corner = part == 0 || part == 2 || part == 5 || part == 7;
+	int w = corner || part == 3 || part == 4 ? SHADOW_PART : 1;
+	int h = corner || part == 1 || part == 6 ? SHADOW_PART : 1;
+	cairo_t *cairo;
+	struct wlr_buffer *buffer = waydesk_cairo_buffer_create(w, h, &cairo);
+	if (!buffer) {
+		return NULL;
+	}
+	cairo_surface_t *surface = cairo_get_target(cairo);
+	uint32_t *pixels = (uint32_t *)cairo_image_surface_get_data(surface);
+	int stride = cairo_image_surface_get_stride(surface) / 4;
+	bool mirror_x = part == 2 || part == 4 || part == 7;
+	bool mirror_y = part == 5 || part == 6 || part == 7;
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			float a;
+			if (part == 8) {
+				a = SHADOW_PEAK;
+			} else {
+				// The pieces on the right and the bottom are the mirror image of the ones on the left and the top.
+				float px = (mirror_x ? w - 1 - x : x) + 0.5f;
+				float py = (mirror_y ? h - 1 - y : y) + 0.5f;
+				float d;
+				if (corner) {
+					d = corner_distance(px, py);
+				} else if (part == 1 || part == 6) {
+					d = SHADOW_BLUR - py;
+				} else {
+					d = SHADOW_BLUR - px;
+				}
+				a = shadow_alpha(d);
+			}
+			pixels[y * stride + x] = (uint32_t)(a * 255.0f + 0.5f) << 24; // black, premultiplied
+		}
+	}
+	cairo_surface_mark_dirty(surface);
+	return buffer;
+}
+
+static bool shadow_accepts_input(struct wlr_scene_buffer *buffer, double *x, double *y) {
+	return false;
+}
+
+struct waydesk_shadow *waydesk_shadow_create(struct wlr_scene_tree *parent) {
+	for (int i = 0; i < 9; i++) {
+		if (!shadow_textures[i] && !(shadow_textures[i] = make_shadow_texture(i))) {
+			return NULL;
+		}
+	}
+	struct waydesk_shadow *shadow = calloc(1, sizeof(*shadow));
+	if (!shadow) {
+		return NULL;
+	}
+	shadow->tree = wlr_scene_tree_create(parent);
+	if (!shadow->tree) {
+		free(shadow);
+		return NULL;
+	}
+	for (int i = 0; i < 9; i++) {
+		shadow->part[i] = wlr_scene_buffer_create(shadow->tree, shadow_textures[i]);
+		if (!shadow->part[i]) {
+			wlr_scene_node_destroy(&shadow->tree->node);
+			free(shadow);
+			return NULL;
+		}
+		shadow->part[i]->point_accepts_input = shadow_accepts_input;
+	}
+	wlr_scene_node_set_enabled(&shadow->tree->node, false);
+	wlr_scene_node_lower_to_bottom(&shadow->tree->node);
+	shadow->strength = -1;
+	return shadow;
+}
+
+void waydesk_shadow_update(struct waydesk_shadow *shadow, int width, int height, bool visible, float strength) {
+	const int m = SHADOW_BLUR, k = SHADOW_INSIDE, s = SHADOW_PART, ox = SHADOW_DX, oy = SHADOW_DY;
+	// A window too small for the corner pieces gets no shadow.
+	visible = visible && width > 2 * k && height > 2 * k;
+	if (shadow->visible != visible) {
+		shadow->visible = visible;
+		wlr_scene_node_set_enabled(&shadow->tree->node, visible);
+	}
+	if (!visible) {
+		return;
+	}
+	if (shadow->strength != strength) {
+		shadow->strength = strength;
+		for (int i = 0; i < 9; i++) {
+			wlr_scene_buffer_set_opacity(shadow->part[i], strength);
+		}
+	}
+	if (shadow->width == width && shadow->height == height) {
+		return;
+	}
+	shadow->width = width;
+	shadow->height = height;
+	int iw = width - 2 * k, ih = height - 2 * k;
+	struct { int x, y, w, h; } at[9] = {
+		{ox - m, oy - m, s, s}, {ox + k, oy - m, iw, s}, {ox + width - k, oy - m, s, s},
+		{ox - m, oy + k, s, ih}, {ox + width - k, oy + k, s, ih},
+		{ox - m, oy + height - k, s, s}, {ox + k, oy + height - k, iw, s}, {ox + width - k, oy + height - k, s, s},
+		{ox + k, oy + k, iw, ih},
+	};
+	for (int i = 0; i < 9; i++) {
+		wlr_scene_node_set_position(&shadow->part[i]->node, at[i].x, at[i].y);
+		wlr_scene_buffer_set_dest_size(shadow->part[i], at[i].w, at[i].h);
+	}
+}
+
+// ---- the corner of a title bar ----
+
+struct wlr_buffer *waydesk_corner_buffer(int radius, int scale, bool right,
+		const float fill[4], const float line[4]) {
+	int size = radius * scale;
+	cairo_t *cairo;
+	struct wlr_buffer *buffer = waydesk_cairo_buffer_create(size, size, &cairo);
+	if (!buffer) {
+		return NULL;
+	}
+	double r = size, cx = right ? 0 : size, outline = scale;
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	cairo_set_source_rgba(cairo, line[0], line[1], line[2], line[3]);
+	cairo_arc(cairo, cx, r, r, 0, 2 * 3.14159265358979323846);
+	cairo_fill(cairo);
+	cairo_set_source_rgba(cairo, fill[0], fill[1], fill[2], fill[3]);
+	cairo_arc(cairo, cx, r, r - outline, 0, 2 * 3.14159265358979323846);
+	cairo_fill(cairo);
+	cairo_surface_flush(cairo_get_target(cairo));
+	return buffer;
+}
+
+// ---- the cursor of an application ----
+
+static size_t base64_encode(const uint8_t *in, size_t len, char *out) {
+	static const char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	size_t n = 0;
+	for (size_t i = 0; i < len; i += 3) {
+		uint32_t v = in[i] << 16;
+		if (i + 1 < len) v |= in[i + 1] << 8;
+		if (i + 2 < len) v |= in[i + 2];
+		out[n++] = table[(v >> 18) & 63];
+		out[n++] = table[(v >> 12) & 63];
+		out[n++] = i + 1 < len ? table[(v >> 6) & 63] : '=';
+		out[n++] = i + 2 < len ? table[v & 63] : '=';
+	}
+	return n;
+}
+
+char *waydesk_cursor_payload(struct wlr_surface *surface, int hotspot_x, int hotspot_y) {
+	struct wlr_texture *texture = wlr_surface_get_texture(surface);
+	if (!texture || texture->width <= 0 || texture->height <= 0 || texture->width > 64 || texture->height > 64) {
+		return NULL;
+	}
+	int w = texture->width, h = texture->height;
+	uint32_t stride = w * 4;
+	uint8_t *pixels = calloc(h, stride);
+	if (!pixels) {
+		return NULL;
+	}
+	struct wlr_texture_read_pixels_options options = {
+		.data = pixels,
+		.format = DRM_FORMAT_ARGB8888,
+		.stride = stride,
+	};
+	if (!wlr_texture_read_pixels(texture, &options)) {
+		free(pixels);
+		return NULL;
+	}
+	// The hotspot is in surface coordinates: in pixels it is scaled by the buffer scale.
+	int scale = surface->current.scale > 0 ? surface->current.scale : 1;
+	size_t length = 64 + ((size_t)h * stride + 2) / 3 * 4 + 1;
+	char *payload = malloc(length);
+	if (!payload) {
+		free(pixels);
+		return NULL;
+	}
+	int head = snprintf(payload, length, "cursorimg:%d,%d,%d,%d,", hotspot_x * scale, hotspot_y * scale, w, h);
+	size_t n = base64_encode(pixels, (size_t)h * stride, payload + head);
+	payload[head + n] = '\0';
+	free(pixels);
+	return payload;
+}
