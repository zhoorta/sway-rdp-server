+#ifndef _SWAY_WAYDESK_DRAW_H
+#define _SWAY_WAYDESK_DRAW_H
+#include <stdbool.h>
+#include <cairo.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_compositor.h>
+
+/**
+ * A buffer of width x height pixels (ARGB, premultiplied) with a cairo context to draw in. The context lives as long as the buffer.
+ */
+struct wlr_buffer *waydesk_cairo_buffer_create(int width, int height, cairo_t **cairo);
+
+/**
+ * A soft shadow around a window: nine pieces (four corners, four edges and the inside) of two pictures made once, so that moving or resizing a window
+ * only moves and stretches scene nodes. It sits at the bottom of the container's scene tree, outside the container's own rectangle.
+ */
+struct waydesk_shadow {
+	struct wlr_scene_tree *tree;
+	struct wlr_scene_buffer *part[9];
+	int width, height;
+	bool visible;
+	float strength;
+};
+
+struct waydesk_shadow *waydesk_shadow_create(struct wlr_scene_tree *parent);
+
+/**
+ * Places the shadow around a container of this size, shown or not, with this strength (0 to 1).
+ */
+void waydesk_shadow_update(struct waydesk_shadow *shadow, int width, int height, bool visible, float strength);
+
+/**
+ * The picture of one rounded top corner of a title bar: a quarter of a disc of the fill colour with an outline of the line colour,
+ * radius pixels (logical) at the output scale; transparent outside the arc.
+ */
+struct wlr_buffer *waydesk_corner_buffer(int radius, int scale, bool right,
+		const float fill[4], const float line[4]);
+
+/**
+ * The picture of the cursor an application drew itself (a surface), as the payload of a tick event: "cursorimg:HOTX,HOTY,W,H,DATA", the
+ * pixels as base64 of W x H 32 bit ARGB (premultiplied, rows from the top), the hotspot in pixels. NULL when there is no picture yet or
+ * it is bigger than 64 x 64. The caller frees the string.
+ */
+char *waydesk_cursor_payload(struct wlr_surface *surface, int hotspot_x, int hotspot_y);
+
+#endif
