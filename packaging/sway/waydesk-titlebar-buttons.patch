+int container_titlebar_button_at(struct sway_container *con, double lx, double ly) {
+	if (!con->view || !con->title_bar.tree->node.enabled || con->pending.fullscreen_mode) {
+		return -1;
+	}
+	if (ly < 0 || ly >= container_titlebar_height()) {
+		return -1;
+	}
+	for (int i = 0; i < 3; i++) {
+		struct sway_text_node *node = con->title_bar.buttons[i];
+		if (!node || !node->node->enabled) {
+			continue;
+		}
+		if (lx >= node->node->x && lx < node->node->x + (int)node->width &&
+				ly >= node->node->y && ly < node->node->y + (int)node->height) {
+			return i;
+		}
+	}
+	return -1;
+}
