+// An application that draws its own window buttons asks for maximize or minimize: do what the title bar buttons do
+// (titlebar_button), on that window. A floating window would otherwise ignore the request.
+static void run_window_button(struct sway_view *view, int which, const char *suffix) {
+	if (!config->titlebar_buttons[which] || !view->container || !view->surface || !view->surface->mapped) {
+		return;
+	}
+	struct sway_seat *seat = input_manager_current_seat();
+	seat_set_focus(seat, &view->container->node);
+	size_t len = strlen(config->titlebar_buttons[which]) + strlen(suffix) + 1;
+	char *copy = malloc(len);
+	if (copy) {
+		snprintf(copy, len, "%s%s", config->titlebar_buttons[which], suffix);
+		list_t *res_list = execute_command(copy, seat, view->container);
+		for (int i = 0; i < res_list->length; ++i) {
+			free_cmd_results(res_list->items[i]);
+		}
+		list_free(res_list);
+		free(copy);
+	}
+	transaction_commit_dirty();
+}
