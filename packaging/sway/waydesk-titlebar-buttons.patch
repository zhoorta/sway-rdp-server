+static void update_title_bar_iterator(struct sway_container *con, void *data) {
+	if (con->view) {
+		container_update_title_bar(con);
+	}
+}
+
+static int button_index(const char *name) {
+	if (strcmp(name, "close") == 0) {
+		return 0;
+	} else if (strcmp(name, "minimize") == 0) {
+		return 1;
+	} else if (strcmp(name, "maximize") == 0) {
+		return 2;
+	}
+	return -1;
+}
+
+// titlebar_button close|minimize|maximize <command>
+// titlebar_button color close|minimize|maximize <#rrggbb>   (colour of the button under the pointer)
+// titlebar_button none
+struct cmd_results *cmd_titlebar_button(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "titlebar_button", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	if (strcmp(argv[0], "color") == 0) {
+		if ((error = checkarg(argc, "titlebar_button", EXPECTED_EQUAL_TO, 3))) {
+			return error;
+		}
+		int which = button_index(argv[1]);
+		uint32_t rgba;
+		if (which < 0 || !parse_color(argv[2], &rgba)) {
+			return cmd_results_new(CMD_INVALID,
+					"Expected 'titlebar_button color close|minimize|maximize <#rrggbb>'");
+		}
+		config->titlebar_button_hover[which][0] = ((rgba >> 24) & 0xff) / 255.0f;
+		config->titlebar_button_hover[which][1] = ((rgba >> 16) & 0xff) / 255.0f;
+		config->titlebar_button_hover[which][2] = ((rgba >> 8) & 0xff) / 255.0f;
+		config->titlebar_button_hover[which][3] = (rgba & 0xff) / 255.0f;
+		config->titlebar_button_hover_set[which] = true;
+	} else if (argc == 1 && strcmp(argv[0], "none") == 0) {
+		for (int i = 0; i < 3; i++) {
+			free(config->titlebar_buttons[i]);
+			config->titlebar_buttons[i] = NULL;
+		}
+	} else {
+		int which = button_index(argv[0]);
+		if (which < 0) {
+			return cmd_results_new(CMD_INVALID,
+					"Expected 'titlebar_button close|minimize|maximize <command>' or 'titlebar_button none'");
+		}
+		if ((error = checkarg(argc, "titlebar_button", EXPECTED_AT_LEAST, 2))) {
+			return error;
+		}
+		char *command = join_args(argv + 1, argc - 1);
+		free(config->titlebar_buttons[which]);
+		config->titlebar_buttons[which] = command;
+	}
+
+	root_for_each_container(update_title_bar_iterator, NULL);
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
