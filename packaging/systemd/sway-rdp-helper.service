[Unit]
Description=sway-rdp helper (root: login checks and session start for the sway-rdp daemon)
Documentation=file:///usr/share/doc/sway-rdp/README.md
After=network.target
Before=sway-rdp.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/sway-rdp
ExecStart=/usr/bin/sway-rdp-server --helper --daemon-user sway-rdp --systemd-sessions
Restart=on-failure
RestartSec=2
# The helper's runtime directory holds its two sockets.
RuntimeDirectory=sway-rdp
RuntimeDirectoryMode=0755
# Sessions are separate units (sway-rdp-session@<uid>.service), so none of this sandbox reaches the accounts'
# desktops, and they keep running when this service restarts (the sessions register again).
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
