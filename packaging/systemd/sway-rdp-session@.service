[Unit]
Description=sway-rdp session of uid %i (a headless sway that survives RDP disconnects)
Documentation=file:///usr/share/doc/sway-rdp/README.md
After=user@%i.service sway-rdp-helper.service

[Service]
Type=simple
User=%i
# Part of the account's own slice: resource limits set on user-<uid>.slice (or user-.slice.d/) apply to the session.
Slice=user-%i.slice
EnvironmentFile=-/etc/default/sway-rdp
Environment=XDG_RUNTIME_DIR=/run/user/%i LANG=C.UTF-8
ExecStart=/usr/bin/sway-rdp-server --session-worker --own-sway --register /run/sway-rdp/sessions.sock $SWAY_RDP_SESSION_ARGS
Restart=no
KillMode=control-group
TimeoutStopSec=15
# No sandbox on purpose: this is the account's desktop, and sudo, flatpak and browsers need to work in it.
