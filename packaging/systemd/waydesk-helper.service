[Unit]
Description=waydesk helper (root: login checks and session start for the waydesk daemon)
Documentation=file:///usr/share/doc/waydesk/README.md
After=network.target
Before=waydesk.service

[Service]
Type=simple
# Only members of this group may log in. It is the default here so that an upgrade cannot open the server to every ordinary
# account; /etc/default/waydesk overrides it (WAYDESK_HELPER_ARGS= with nothing after it lets every ordinary account in).
Environment="WAYDESK_HELPER_ARGS=--require-group waydesk-users"
EnvironmentFile=-/etc/default/waydesk
ExecStart=/usr/bin/waydesk-server --helper --daemon-user waydesk --systemd-sessions $WAYDESK_HELPER_ARGS
Restart=on-failure
RestartSec=2
# The helper's runtime directory holds its two sockets.
RuntimeDirectory=waydesk
RuntimeDirectoryMode=0755
# Sessions are separate units (waydesk-session@<uid>.service), so none of this sandbox reaches the accounts'
# desktops, and they keep running when this service restarts (the sessions register again).
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
# The helper only talks to local sockets (the daemon, the sessions, systemd) and PAM: no network, no devices, no clock, no writable
# homes, no writable and executable memory. An account database that needs the network from PAM itself (pam_ldap, not sssd)
# needs IPAddressDeny=any and RestrictAddressFamilies lifted in a drop-in.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectHome=read-only
MemoryDenyWriteExecute=yes
ProtectKernelLogs=yes
# What it uses of root: handing its socket to the daemon account (chown), reading the account database for PAM, writing the
# audit record of a login. Starting the sessions goes through systemd, which has the rest.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_AUDIT_WRITE CAP_SETUID CAP_SETGID
SystemCallArchitectures=native
# Ordinary service calls only. @privileged stays allowed on purpose (chown of the socket, the setuid and setgid that PAM and
# the login check use); mount, module, raw I/O, reboot, clock, debug and the other special groups are not in @system-service.
# A refused call fails with EPERM instead of killing the helper, so a missing entry is a failed login, not an outage.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# 64 connections at once plus PAM: far more than it needs, small enough that a leak or a flood cannot take the host.
MemoryMax=256M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
