+/// The quantiser every PPS starts from. With constant quality the real one goes in each slice header (`slice_qp_delta`), so a change of
+/// quality needs no new parameter sets: a client that rebuilds its decoder on a new PPS, or loses the keyframe while it does, shows a
+/// washed-out picture until the next keyframe (Windows App).
+const PPS_INIT_QP: u8 = 26;
+
 pub(crate) struct LowDelayH264Delegate {
     /// Current sequence SPS
     sps: Option<Rc<Sps>>,
@@ -70,6 +75,18 @@
         }
     }
 
+    /// The slice quantiser relative to the PPS: constant quality asks for its own, the other modes start from the middle as the PPS used to.
+    fn slice_qp_delta(&self) -> i8 {
+        let min_qp = self.tunings.min_quality.max(MIN_QP as u32);
+        let max_qp = self.tunings.max_quality.min(MAX_QP as u32);
+        let qp = if let RateControl::ConstantQuality(qp) = self.tunings.rate_control {
+            qp.clamp(min_qp, max_qp) as i32
+        } else {
+            ((min_qp + max_qp) / 2) as i32
+        };
+        (qp - i32::from(PPS_INIT_QP)) as i8
+    }
