+    /// Serves one accepted connection. Returns the connection that replaced it, if any, and whether the
+    /// connection handler asked the server to stop.
+    async fn serve_connection(
+        &mut self,
+        listener: &tokio::net::TcpListener,
+        stream: tokio::net::TcpStream,
+        peer: SocketAddr,
+    ) -> (Option<(tokio::net::TcpStream, SocketAddr)>, bool) {
+        let accepted = self.connection_handler.as_mut().is_none_or(|h| h.on_accept(peer));
+        if !accepted {
+            debug!(?peer, "Connection rejected by handler");
+            drop(stream);
+            return (None, false);
+        }
+
+        let started = tokio::time::Instant::now();
+        let mut replacement = None;
+        let result = if self.opts.replace_on_new_connection {
+            tokio::select! {
+                result = self.run_connection(stream) => result,
+                accepted = listener.accept() => match accepted {
+                    Ok((new_stream, new_peer)) => {
+                        // Dropping the future above closes the old client's socket.
+                        debug!(?peer, ?new_peer, "Replacing the current connection");
+                        replacement = Some((new_stream, new_peer));
+                        Err(anyhow::anyhow!("replaced by a new connection from {new_peer}"))
+                    }
+                    Err(error) => Err(anyhow::anyhow!(error).context("accept failed while serving a client")),
+                },
+            }
+        } else {
+            self.run_connection(stream).await
+        };
+        let duration = started.elapsed();
+
+        match (&result, replacement.is_some()) {
+            (Err(error), true) => debug!(?error, "Connection ended"),
+            (Err(error), false) => error!(?error, "Connection error"),
+            _ => {}
+        }
+
+        self.static_channels = StaticChannelSet::new();
