+/// The NVENC library, loaded when first needed instead of linked: a binary that has this crate must start on a machine without NVIDIA's libraries.
+fn nvenc_lib() -> Result<&'static libloading::Library, String> {
+    static LIB: std::sync::OnceLock<Result<libloading::Library, String>> = std::sync::OnceLock::new();
+    LIB.get_or_init(|| unsafe { libloading::Library::new("libnvidia-encode.so.1") }.map_err(|e| e.to_string()))
+        .as_ref()
+        .map_err(Clone::clone)
+}
